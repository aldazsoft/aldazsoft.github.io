@inherits LayoutComponentBase

<MudThemeProvider @ref="themeProvider"
                  @bind-IsDarkMode="isDarkMode"
                  Theme="SiteTheme.Instance"
                  ObserveSystemDarkModeChange="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <SiteAppBar IsDarkMode="isDarkMode"
                OnToggleDarkMode="ToggleDarkMode"
                OnToggleDrawer="ToggleDrawer" />

    <MudDrawer @bind-Open="isDrawerOpen" Variant="DrawerVariant.Temporary" Elevation="1">
        <SiteNavigation OnNavigate="CloseDrawer" />
    </MudDrawer>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Medium" Class="py-10">
            @Body
            <SiteFooter />
        </MudContainer>
    </MudMainContent>
</MudLayout>

@code {
    private MudThemeProvider themeProvider = default!;
    private bool isDarkMode;
    private bool isDrawerOpen;

    /// <inheritdoc />
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        isDarkMode = await themeProvider.GetSystemDarkModeAsync();
        StateHasChanged();
    }

    private void ToggleDarkMode() => isDarkMode = !isDarkMode;

    private void ToggleDrawer() => isDrawerOpen = !isDrawerOpen;

    private void CloseDrawer() => isDrawerOpen = false;
}
