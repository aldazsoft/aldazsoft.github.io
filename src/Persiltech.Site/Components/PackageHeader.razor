<MudText Typo="Typo.h3" HtmlTag="h1">@Package.Id</MudText>

<MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mt-3 mb-5">
    @Package.Summary
</MudText>

<div class="d-flex flex-wrap align-center gap-2">
    <MudLink Href="@Package.NuGetUrl" Target="_blank" rel="noopener">
        <img src="@Package.VersionBadgeUrl" alt="Versión publicada en NuGet" height="20" />
    </MudLink>
    <MudLink Href="@SiteLinks.LicenseUrl" Target="_blank" rel="noopener">
        <img src="https://img.shields.io/badge/License-MIT-blue.svg" alt="Licencia MIT" height="20" />
    </MudLink>
    <MudLink Href="@SiteLinks.SponsorUrl" Target="_blank" rel="noopener">
        <img src="https://img.shields.io/badge/Sponsor-GitHub-ea4aaa.svg" alt="Patrocinar el desarrollo" height="20" />
    </MudLink>
</div>

@code {
    /// <summary>Paquete cuya cabecera se muestra.</summary>
    [Parameter, EditorRequired]
    public NuGetPackage Package { get; set; } = default!;
}
