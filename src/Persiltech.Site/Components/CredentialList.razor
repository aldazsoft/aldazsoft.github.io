<MudSimpleTable Dense="true" Hover="true" Bordered="false" Striped="false" Class="my-4">
    <tbody>
        @foreach (var credential in Credentials)
        {
            <tr>
                <td class="credential-period"><MudText Typo="Typo.caption" Color="Color.Secondary">@credential.Period</MudText></td>
                <td>
                    <MudText Typo="Typo.body2">@credential.Title</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@credential.Institution</MudText>
                </td>
            </tr>
        }
    </tbody>
</MudSimpleTable>

@code {
    /// <summary>Titulaciones o cursos que se listan.</summary>
    [Parameter, EditorRequired]
    public IReadOnlyList<Credential> Credentials { get; set; } = [];
}
