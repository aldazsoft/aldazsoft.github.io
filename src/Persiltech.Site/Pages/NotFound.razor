@page "/404"

<PageTitle>Página no encontrada</PageTitle>

<MudText Typo="Typo.h3" HtmlTag="h1">Página no encontrada</MudText>

<MudText Typo="Typo.subtitle1" Color="Color.Secondary" Class="mt-3">
    La dirección que has abierto no corresponde a ninguna página de este sitio.
</MudText>

<MudButton Href="/"
           Variant="Variant.Filled"
           Color="Color.Primary"
           StartIcon="@Icons.Material.Outlined.ArrowBack"
