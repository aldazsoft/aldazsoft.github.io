@page "/"
@inject IProfileService ProfileService
@inject IPackageCatalog Catalog

<PageTitle>Edinson Aldaz</PageTitle>

<HeroSection Title="@profile.FullName" Subtitle="@profile.Headline">
    <Actions>
        <MudButton Href="/packages"
                   Variant="Variant.Filled"
                   Color="Color.Primary"
                   EndIcon="@Icons.Material.Outlined.ArrowForward">
            Ver los paquetes
        </MudButton>
        <MudButton Href="/contact" Variant="Variant.Outlined" Color="Color.Primary">
            Contacto
        </MudButton>
    </Actions>
</HeroSection>

<MudText Typo="Typo.body1" Class="mt-2">@profile.Introduction</MudText>

<SectionHeading Text="Paquetes publicados" />

<MudGrid Spacing="4">
    @foreach (var package in Catalog.GetAll())
    {
        <MudItem xs="12" sm="6">
            <PackageCard Package="package" />
        </MudItem>
    }
</MudGrid>

<SectionHeading Text="Tecnologías" />

<SkillGrid Groups="profile.Skills" />

@code {
    private SiteProfile profile = default!;

    /// <inheritdoc />
    protected override void OnInitialized() => profile = ProfileService.GetProfile();
}
