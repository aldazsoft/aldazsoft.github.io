# Normaliza los finales de línea: git almacena LF en el repositorio y entrega
# al working copy lo que indique cada regla de abajo.
* text=auto

# Código y proyectos .NET: CRLF en disco (Windows / Visual Studio)
*.cs        text diff=csharp eol=crlf
*.csx       text diff=csharp eol=crlf
*.csproj    text eol=crlf
*.slnx      text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.resx      text eol=crlf
*.config    text eol=crlf
*.ps1       text eol=crlf

# Formatos que esperan LF, incluso en Windows
*.yml       text eol=lf
*.yaml      text eol=lf
*.sh        text eol=lf
*.json      text eol=lf
*.md        text eol=lf
.gitattributes text eol=lf
.gitignore  text eol=lf
.editorconfig text eol=lf

# Multiplataforma: se respeta lo que haya
*.txt       text
*.xml       text

# Binarios: nunca normalizar ni intentar diff textual
*.png       binary
*.jpg       binary
*.ico       binary
*.pdf       binary
*.zip       binary
*.nupkg     binary
*.snupkg    binary
*.snk       binary
*.dll       binary
*.exe       binary
*.pdb       binary
